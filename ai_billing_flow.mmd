%% ============================================================================
%% LangGraph StateGraph Architecture: AI Billing Assistant
%% Migrated: Legacy manual generateContent for-loop -> LangGraph StateGraph
%% Stack: @langchain/langgraph, @langchain/google-genai, @langchain/core, zod
%% ============================================================================

sequenceDiagram
    autonumber
    actor Admin as Admin Operator
    participant UI as Admin Chat Drawer
    participant Server as Express Server (/api/admin/ai/ask)
    participant Graph as LangGraph StateGraph
    participant Agent as Agent Node (ChatGoogleGenerativeAI)
    participant Condition as Conditional Edge (toolsCondition)
    participant Tools as ToolNode (billingTools)
    participant DB as PostgreSQL Database

    Note over Server,Graph: Migrated to LangGraph StateGraph with Agent & Tool Nodes
    Admin->>UI: Types billing query (e.g. "Show pending amount and unpaid bills")
    UI->>Server: POST /api/admin/ai/ask { message, history }
    Server->>Graph: graph.invoke({ messages }, { recursionLimit: 10 })

    rect rgb(240, 248, 255)
        Note over Graph,Agent: Node: agent
        Graph->>Agent: callModel(state): Prepend SYSTEM_PROMPT + state.messages
        Agent->>Condition: Return AIMessage (checks for tool_calls)
    end

    alt Has tool_calls (LLM decides tools are needed)
        Condition->>Tools: Route to "tools" node
        rect rgb(245, 255, 245)
            Note over Tools,DB: Node: tools (ToolNode auto-execution)
            Tools->>DB: Execute get_unpaid_bills / get_billing_summary query
            DB-->>Tools: PostgreSQL query result rows
            Tools->>Graph: Append ToolMessages (serialized JSON)
        end
        Note over Graph,Agent: Loop back via edge: 'tools' -> 'agent'
        Graph->>Agent: callModel(state with ToolMessages context)
        Agent->>Condition: Return new AIMessage
    end

    rect rgb(255, 250, 240)
        Condition->>Graph: No tool_calls -> Route to END
    end

    Graph-->>Server: Final State (last AIMessage + aggregated tool_calls)
    Server-->>UI: 200 OK { success: true, data: { reply, toolsUsed } }
    UI-->>Admin: Render clean formatted response with tool badge
